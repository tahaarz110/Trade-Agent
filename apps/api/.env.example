# =============================================================================
# Professional ICT Trading Journal — API environment configuration (Phase 0)
# Copy this file to `.env` and adjust values for your environment.
# =============================================================================

# --- App -----------------------------------------------------------------
APP_NAME="Professional ICT Trading Journal API"
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of origins allowed to call the API from the browser
CORS_ORIGINS=http://localhost:3000

# --- Database --------------------------------------------------------------
# PostgreSQL 16 connection string (SQLAlchemy 2.x + psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://trade_agent:trade_agent@localhost:5432/trade_agent

# --- Storage paths -----------------------------------------------------------
# Directory where trade image/file attachments are stored
ATTACHMENT_DIR=../../storage/attachments
# Directory where database/application backups are written
BACKUP_DIR=../../storage/backups
# Directory where Apache Parquet analytical snapshots are written
PARQUET_DIR=../../storage/analytics/parquet

# --- Feature flags -----------------------------------------------------------
# When true, disables heavy AI features/embeddings and favors template-based
# reports and batched analytics for weaker hardware. See Master Prompt
# "LOW-RESOURCE MODE" section.
LOW_RESOURCE_MODE=true

# When true, enables the optional AI narrator layer (Ollama / LM Studio /
# Gemini / Groq / OpenRouter). The narrator only ever explains deterministic
# outputs and is never required for core functionality.
AI_NARRATOR_ENABLED=false

# Cron-style or keyword schedule controlling how often heavy background
# analytics jobs (feature snapshots, pattern discovery, etc.) run.
# Accepted keywords in later phases: manual | daily | weekly (or a cron expr)
ANALYTICS_SCHEDULE=daily
