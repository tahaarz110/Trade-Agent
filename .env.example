# =============================================================================
# Professional ICT Trading Journal — root environment reference (Phase 0)
#
# This file documents every environment variable used across the stack.
# In practice each app reads its own .env file:
#   - apps/api/.env   (copied from apps/api/.env.example)
#   - apps/web/.env    (copied from apps/web/.env.example)
# =============================================================================

# ---------------------------------------------------------------------------
# DATABASE_URL
# SQLAlchemy 2.x connection string for PostgreSQL 16 (psycopg 3 driver).
# Local dev default:
#   postgresql+psycopg://trade_agent:trade_agent@localhost:5432/trade_agent
# Inside docker compose, host is `db` instead of `localhost`.
DATABASE_URL=postgresql+psycopg://trade_agent:trade_agent@localhost:5432/trade_agent

# ---------------------------------------------------------------------------
# ATTACHMENT_DIR
# Filesystem directory where trade image/file attachments are stored.
ATTACHMENT_DIR=./storage/attachments

# ---------------------------------------------------------------------------
# BACKUP_DIR
# Filesystem directory where database/application backups are written.
BACKUP_DIR=./storage/backups

# ---------------------------------------------------------------------------
# PARQUET_DIR
# Filesystem directory where Apache Parquet analytical snapshots are written
# (used by the Offline Intelligence Engine / DuckDB in later phases).
PARQUET_DIR=./storage/analytics/parquet

# ---------------------------------------------------------------------------
# LOW_RESOURCE_MODE
# true | false — when true, disables heavy AI models/embeddings, favors
# template-based Persian reports, and runs analytics as batched background
# jobs so the app stays usable on modest hardware.
LOW_RESOURCE_MODE=true

# ---------------------------------------------------------------------------
# AI_NARRATOR_ENABLED
# true | false — enables the OPTIONAL AI narrator/chat layer (Ollama, LM
# Studio, Gemini, Groq/OpenRouter). The narrator only explains deterministic
# analytics output and is never required for core functionality. Disabled
# by default, especially in low-resource mode.
AI_NARRATOR_ENABLED=false

# ---------------------------------------------------------------------------
# ANALYTICS_SCHEDULE
# manual | daily | weekly | <cron expression> — controls how often heavy
# background analytics jobs (feature snapshots, pattern discovery, insight
# validation) refresh.
ANALYTICS_SCHEDULE=daily

# ---------------------------------------------------------------------------
# Frontend-only (see apps/web/.env.example)
# NEXT_PUBLIC_API_URL=http://localhost:8000
